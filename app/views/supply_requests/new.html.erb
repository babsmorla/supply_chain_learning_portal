<div class="max-w-2xl mx-auto mt-10 px-6">
  <div class="mb-6">
    <%= link_to "← Back to requests",
                supply_requests_path,
                class: "text-sm underline" %>
  </div>
  <div class="border rounded-lg p-6">
    <h1 class="text-2xl font-bold mb-6">
      New Supply Request
    </h1>
    <% if @supply_request.errors.any? %>
      <div class="mb-6 border border-red-200 bg-red-50 rounded-lg p-4">
        <h2 class="font-semibold text-red-700 mb-2">
          Something went wrong:
        </h2>
        <ul class="list-disc pl-5 text-sm text-red-700">
          <% @supply_request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form_with model: @supply_request, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :item_name,
                       class: "block text-sm font-medium mb-1" %>
        <%= form.text_field :item_name,
                            class: "w-full border rounded-lg px-3 py-2",
                            placeholder: "e.g. Dell Laptop" %>
      </div>
      <div>
        <%= form.label :quantity,
                       class: "block text-sm font-medium mb-1" %>
        <%= form.number_field :quantity,
                              class: "w-full border rounded-lg px-3 py-2",
                              min: 1 %>
      </div>
      <div>
        <%= form.label :reason,
                       class: "block text-sm font-medium mb-1" %>
        <%= form.text_area :reason,
                           class: "w-full border rounded-lg px-3 py-2",
                           rows: 4,
                           placeholder: "Why is this item needed?" %>
      </div>
      <div>
        <%= form.submit "Submit Request",
                        class: "px-4 py-2 bg-black text-white rounded-lg cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>