<div class="max-w-2xl mx-auto mt-10 px-6">
  <div class="mb-6">
    <%= link_to "← Back to requests",
                supply_requests_path,
                class: "text-sm underline" %>
  </div>
  <div class="border rounded-lg p-6">
    <h1 class="text-2xl font-bold mb-6">
      Supply Request
    </h1>
    <div class="space-y-4">
      <div>
        <p class="text-sm text-gray-500">Item</p>
        <p class="font-medium">
          <%= @supply_request.item_name %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Quantity</p>
        <p class="font-medium">
          <%= @supply_request.quantity %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Reason</p>
        <p class="font-medium">
          <%= @supply_request.reason %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Status</p>
        <%= status_badge(@supply_request.status) %>
      </div> 
      <div>
        <p class="text-sm text-gray-500">Requested by</p>
        <p class="font-medium">
          <%= @supply_request.user.name %>
        </p>
      </div>
    </div>
  </div>

  <% unless @supply_request.status == "approved" %>
  <%= button_to 'Approve Request', approve_supply_request_path, method: :patch, class: "mt-4 px-4 py-2 bg-black text-white rounded-lg" %>
  <% end %>
</div>